---
import BaseLayout from '../layouts/BaseLayout.astro';

const examples = [
    { href: 'blog/amend-sample', type: 'Markdown + frontmatter',
      title: 'Sample article', detail: 'Title, introduction and complete body.' },
    { href: 'demo/stories/example', type: 'Standalone HTML',
      title: 'Sample story', detail: 'A complete titleless fragment; also an example for a new story page.' },
    { href: 'demo/notes/example', type: 'JSON HTML field',
      title: 'Sample note', detail: 'Only one HTML string is owned; other fields stay untouched.' },
    { href: 'demo/features/example', type: 'JSON collection item',
      title: 'Sample feature', detail: 'An owned title and body, plus a separate new-item recipe.' },
    { href: 'demo/quotes/example', type: 'Titleless collection item',
      title: 'Sample quote', detail: 'Only the chosen item’s HTML is authored.' },
];
---

<BaseLayout title="Amend examples • Arne Boedt" active="blog" footer="compact">
    <main class="max-w-screen-xl mx-auto px-8 pt-14 pb-20">
        <a href="blog" class="text-sm text-slate-500 hover:text-slate-700">← Back to writing</a>
        <h1 class="heading-font text-4xl md:text-5xl font-semibold tracking-tighter mt-5">Content examples</h1>
        <p class="mt-4 max-w-2xl text-slate-600 leading-relaxed">
            Placeholder content for exploring Amend in this local site. These are examples, not client
            work, testimonials, or published claims. Open a page, then choose Write content in Amend
            to see whether its declared source agrees with what the site renders.
        </p>

        <div class="mt-10 grid gap-5 md:grid-cols-2" aria-label="Sample content routes">
            {examples.map((example) => (
                <a href={example.href} class="group block bg-white border border-slate-200 hover:border-slate-300 rounded-3xl p-7 transition-colors">
                    <span class="text-xs font-semibold text-indigo-700">{example.type}</span>
                    <h2 class="mt-3 text-xl font-semibold tracking-tight text-slate-900">{example.title}</h2>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">{example.detail}</p>
                    <span class="inline-block mt-5 text-sm font-semibold text-slate-700 group-hover:text-slate-900">View example →</span>
                </a>
            ))}
        </div>

        <p class="mt-9 max-w-2xl text-sm text-slate-600 leading-relaxed">
            In Amend’s Pages overlay, Article and Sample story are separate new-page choices.
            New feature is an independently declared collection-item choice. Submitting a request,
            accepting a revision, and publishing are separate steps; this page performs none of them.
        </p>
    </main>
</BaseLayout>
