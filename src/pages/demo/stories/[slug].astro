---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
    const fragments = import.meta.glob<string>('../../../content/demo/stories/*.html', {
        query: '?raw', import: 'default', eager: true,
    });
    return Object.entries(fragments).map(([path, html]) => ({
        params: { slug: path.split('/').at(-1)!.replace(/\.html$/, '') }, props: { html },
    }));
}

const { html } = Astro.props;
---

<BaseLayout title="Sample story • Arne Boedt" active="blog" footer="compact">
    <main class="max-w-screen-md mx-auto px-8 pt-12 pb-20">
        <a href="demo" class="text-sm text-slate-500 hover:text-slate-700">← Content examples</a>
        <p class="mt-7 text-xs font-semibold text-indigo-700">PLACEHOLDER · STANDALONE HTML</p>
        <h1 class="heading-font mt-3 text-4xl font-semibold tracking-tighter">A story-shaped example</h1>
        <p class="mt-5 text-slate-600">Only the content below is owned by this document.</p>
        <article data-demo-story class="mt-9 prose prose-slate max-w-none" set:html={html} />
    </main>
</BaseLayout>
