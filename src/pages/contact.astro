---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact • Arne Boedt | C# Architecture & AI Transformation" active="contact">
    <header class="max-w-screen-xl mx-auto pt-14 pb-8 px-8">
        <div class="max-w-2xl">
            <div class="uppercase tracking-[2px] text-xs font-semibold text-slate-500">Get in touch</div>
            <h1 class="heading-font text-5xl md:text-6xl tracking-tighter font-semibold mt-2">Let's talk about your next project.</h1>
            <p class="mt-4 text-xl text-slate-600">Most engagements begin with a 60–90 minute discovery conversation. No sales pitch — just an honest discussion of your challenges and goals.</p>
        </div>
    </header>

    <section class="max-w-screen-xl mx-auto px-8 pb-16">
        <div class="grid md:grid-cols-12 gap-x-12">
            <!-- Form -->
            <div class="md:col-span-7">
                <form id="contact-form" class="space-y-5 bg-white border border-slate-200 rounded-3xl p-8">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Full name</label>
                            <input type="text" id="name" name="name" required class="w-full border border-slate-300 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-slate-400">
                        </div>
                        <div>
                            <label for="company" class="block text-sm font-medium text-slate-700 mb-1.5">Company</label>
                            <input type="text" id="company" name="company" required class="w-full border border-slate-300 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-slate-400">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Work email</label>
                            <input type="email" id="email" name="email" required class="w-full border border-slate-300 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-slate-400">
                        </div>
                        <div>
                            <label for="interest" class="block text-sm font-medium text-slate-700 mb-1.5">Primary interest</label>
                            <select id="interest" name="interest" class="w-full border border-slate-300 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-slate-400 bg-white">
                                <option value="C# Architecture">C# &amp; .NET Architecture</option>
                                <option value="AI Evolution">AI Evolution &amp; Integration</option>
                                <option value="Both">Both Architecture + AI</option>
                                <option value="Advisory">Strategic Advisory / Workshop</option>
                                <option value="Other">Other / Not sure yet</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-medium text-slate-700 mb-1.5">What are you trying to achieve?</label>
                        <textarea id="message" name="message" rows="5" required class="w-full border border-slate-300 rounded-3xl px-4 py-3.5 text-sm focus:outline-none focus:border-slate-400 resize-y" placeholder="We're planning a major platform modernization and want to understand how to integrate AI capabilities responsibly..."></textarea>
                    </div>

                    <button type="submit" class="mt-2 w-full sm:w-auto px-9 py-3.5 bg-slate-900 hover:bg-black transition-colors text-white font-semibold rounded-2xl text-sm active:scale-[0.985]">
                        Send inquiry
                    </button>
                    <p class="text-xs text-slate-500">I typically respond within two business days.</p>
                </form>

                <div id="form-success" class="hidden mt-5 rounded-3xl border border-emerald-200 bg-emerald-50 px-6 py-5">
                    <div class="flex gap-x-3">
                        <i class="fa-solid fa-check-circle text-emerald-600 mt-0.5 text-xl"></i>
                        <div>
                            <div class="font-semibold text-emerald-800">Thank you. Your message was received.</div>
                            <p class="text-sm text-emerald-700 mt-1">I'll review your inquiry personally and get back to you shortly.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact info -->
            <div class="md:col-span-5 mt-10 md:mt-0">
                <div class="bg-white border border-slate-200 rounded-3xl p-8">
                    <div class="font-semibold mb-5">Direct contact</div>

                    <div class="space-y-6 text-sm">
                        <div>
                            <div class="text-xs uppercase font-medium tracking-widest text-slate-500">Email</div>
                            <a href="mailto:arne@arneboedt.be" class="text-lg font-medium hover:underline">arne@arneboedt.be</a>
                        </div>

                        <div>
                            <div class="text-xs uppercase font-medium tracking-widest text-slate-500">Schedule time</div>
                            <a href="#" class="text-lg font-medium hover:underline">calendly.com/arneboedt</a>
                        </div>

                        <div>
                            <div class="text-xs uppercase font-medium tracking-widest text-slate-500">LinkedIn</div>
                            <a href="#" class="text-lg font-medium hover:underline">linkedin.com/in/arneboedt</a>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-slate-200">
                        <div class="text-xs uppercase font-semibold tracking-widest text-slate-500 mb-3">Engagement options</div>
                        <div class="flex flex-wrap gap-2">
                            <span class="text-xs px-3 py-1 bg-slate-100 rounded-full">Fixed-scope projects</span>
                            <span class="text-xs px-3 py-1 bg-slate-100 rounded-full">Retainer advisory</span>
                            <span class="text-xs px-3 py-1 bg-slate-100 rounded-full">Workshops</span>
                            <span class="text-xs px-3 py-1 bg-slate-100 rounded-full">Interim leadership</span>
                        </div>
                    </div>
                </div>

                <div class="mt-6 text-xs text-slate-500 px-2">
                    Based in Belgium. Available for on-site work in Europe and remote engagements worldwide.
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const form = document.getElementById('contact-form');
    const success = document.getElementById('form-success');

    form?.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = form.querySelector('button');
        const original = btn?.innerHTML ?? 'Send inquiry';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = 'Sending...';
        }

        setTimeout(() => {
            form.style.display = 'none';
            success?.classList.remove('hidden');
            success?.classList.add('flex');
        }, 800);
    });
</script>
