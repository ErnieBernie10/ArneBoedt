---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services • Arne Boedt | C# Architecture & AI Transformation" active="services">
    <header class="max-w-screen-xl mx-auto pt-14 pb-10 px-8">
        <div class="max-w-3xl">
            <div class="uppercase tracking-[2px] text-xs font-semibold text-slate-500">What I offer</div>
            <h1 class="heading-font text-5xl md:text-6xl font-semibold tracking-tighter mt-2">Services</h1>
            <p class="mt-4 text-xl text-slate-600 max-w-lg">Focused, high-impact engagements designed to deliver lasting architectural and AI capabilities.</p>
        </div>
    </header>

    <!-- Services Grid -->
    <section class="max-w-screen-xl mx-auto px-8 pb-14">
        <div class="grid md:grid-cols-3 gap-6">
            <!-- C# Architecture -->
            <div class="service-card bg-white border border-slate-200 rounded-3xl p-8 flex flex-col">
                <div class="w-11 h-11 rounded-2xl bg-indigo-100 flex items-center justify-center mb-6">
                    <i class="fa-solid fa-code text-indigo-700 text-2xl"></i>
                </div>
                <h3 class="font-semibold text-2xl tracking-tight">C# &amp; .NET Architecture</h3>
                <p class="mt-3 text-slate-600">Design and evolve enterprise-grade .NET systems that remain maintainable for a decade or more.</p>

                <div class="mt-8 flex-1">
                    <ul class="space-y-[13px] text-sm">
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Domain-Driven Design &amp; Clean Architecture</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Modular monoliths &amp; microservices</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Event-driven systems &amp; messaging</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Performance, resilience &amp; observability</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Legacy modernization &amp; platform engineering</li>
                    </ul>
                </div>
                <div class="pt-7 mt-auto border-t border-slate-100">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="tech-badge">.NET 8/9</span>
                        <span class="tech-badge">C# 12</span>
                        <span class="tech-badge">Azure</span>
                        <span class="tech-badge">AWS</span>
                    </div>
                </div>
            </div>

            <!-- AI Evolution -->
            <div class="service-card bg-white border border-slate-200 rounded-3xl p-8 flex flex-col">
                <div class="w-11 h-11 rounded-2xl bg-teal-100 flex items-center justify-center mb-6">
                    <i class="fa-solid fa-brain text-teal-700 text-2xl"></i>
                </div>
                <h3 class="font-semibold text-2xl tracking-tight">AI Evolution Programs</h3>
                <p class="mt-3 text-slate-600">Move beyond experiments. Embed AI into your operating model and core technology stack safely.</p>

                <div class="mt-8 flex-1">
                    <ul class="space-y-[13px] text-sm">
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> AI readiness assessments &amp; roadmaps</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> LLM integration with existing .NET platforms</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> RAG architectures &amp; semantic search</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Responsible AI governance frameworks</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> MLOps foundations &amp; team enablement</li>
                    </ul>
                </div>
                <div class="pt-7 mt-auto border-t border-slate-100">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="tech-badge">Azure OpenAI</span>
                        <span class="tech-badge">Semantic Kernel</span>
                        <span class="tech-badge">LangChain.NET</span>
                        <span class="tech-badge">Vector DBs</span>
                    </div>
                </div>
            </div>

            <!-- Advisory -->
            <div class="service-card bg-white border border-slate-200 rounded-3xl p-8 flex flex-col">
                <div class="w-11 h-11 rounded-2xl bg-amber-100 flex items-center justify-center mb-6">
                    <i class="fa-solid fa-comments text-amber-600 text-2xl"></i>
                </div>
                <h3 class="font-semibold text-2xl tracking-tight">Strategic Advisory</h3>
                <p class="mt-3 text-slate-600">Targeted interventions when you need clarity, direction, or an external perspective.</p>

                <div class="mt-8 flex-1">
                    <ul class="space-y-[13px] text-sm">
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Architecture reviews &amp; decision records</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Executive workshops &amp; strategy offsites</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Technical due diligence (M&amp;A)</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Team coaching &amp; capability building</li>
                        <li class="flex gap-x-2.5"><i class="fa-solid fa-check text-emerald-500 mt-1"></i> Project rescue &amp; turnaround</li>
                    </ul>
                </div>
                <div class="pt-7 mt-auto border-t border-slate-100">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="tech-badge">Workshops</span>
                        <span class="tech-badge">Retainers</span>
                        <span class="tech-badge">1:1 Advisory</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Engagement Models -->
    <section class="max-w-screen-xl mx-auto px-8 py-12 border-t border-slate-200">
        <h2 class="section-header tracking-tighter mb-8">How we can work together</h2>

        <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-7">
                <h4 class="font-semibold">Project-based engagements</h4>
                <p class="text-sm mt-2 text-slate-600">Fixed-scope work for architecture redesigns, AI platform builds, or modernization programs. Typical duration: 3–9 months.</p>
                <div class="text-xs text-slate-500 mt-4">Best for: Clear outcomes with defined deliverables</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-3xl p-7">
                <h4 class="font-semibold">Advisory retainers</h4>
                <p class="text-sm mt-2 text-slate-600">Ongoing access for architecture reviews, strategic guidance, and just-in-time decision support. Flexible monthly commitment.</p>
                <div class="text-xs text-slate-500 mt-4">Best for: Leadership teams and architecture boards</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-3xl p-7">
                <h4 class="font-semibold">Workshops &amp; training</h4>
                <p class="text-sm mt-2 text-slate-600">Intensive 1–3 day sessions on domain modeling, AI strategy, or modern .NET architecture patterns.</p>
                <div class="text-xs text-slate-500 mt-4">Best for: Teams needing accelerated alignment</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-3xl p-7">
                <h4 class="font-semibold">Interim architecture leadership</h4>
                <p class="text-sm mt-2 text-slate-600">Hands-on leadership while you hire or restructure your internal architecture function.</p>
                <div class="text-xs text-slate-500 mt-4">Best for: Critical transitions</div>
            </div>
        </div>
    </section>

    <div class="max-w-screen-xl mx-auto px-8 pb-14">
        <div class="rounded-3xl bg-slate-900 px-8 py-9 text-white">
            <div class="max-w-lg">
                <div class="text-sm font-medium text-slate-400">Ready to explore a collaboration?</div>
                <div class="mt-2 text-2xl font-semibold tracking-tight">Let's start with a conversation.</div>
            </div>
            <a href="/contact" class="mt-6 inline-flex items-center gap-x-2 bg-white text-slate-900 hover:bg-slate-100 font-semibold px-6 py-3 rounded-2xl text-sm transition-all">
                Schedule a discovery call
            </a>
        </div>
    </div>
</BaseLayout>
